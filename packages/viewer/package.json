{
  "name": "@manifold3d/viewer",
  "version": "0.0.0-private",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./flat": "./src/flat.ts",
    "./xr": "./src/xr/index.tsx"
  },
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "build:extension": "vite build --config vite.extension.config.ts --mode production",
    "build:flat": "vite build --config vite.flat.config.ts",
    "clean": "node scripts/clean-builds.mjs",
    "verify:flat": "npm run clean && npm run build && npm run build:flat && node scripts/verify-flat-build.mjs",
    "dev": "vite --config vite.config.ts",
    "dev:viewer": "vite --config vite.config.ts --mode demo"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@jscadui/3mf-export": "^0.5.0",
    "@manifold3d/protocol": "0.0.0-private",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.41.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.0",
    "@types/webxr": "^0.5.24",
    "@vitejs/plugin-react": "^6.0.3",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.1.0"
  }
}
